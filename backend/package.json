{
  "name": "whatsapp-webhook-backend",
  "version": "1.0.0",
  "description": "Production-grade WhatsApp webhook backend with AI classification",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/demo-server.ts",
    "dev:full": "tsx watch src/server.ts",
    "demo": "tsx src/demo-server.ts",
    "lint": "eslint src --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migration:generate": "drizzle-kit generate",
    "migration:run": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.1",
    "postgres": "^3.4.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "openai": "^4.20.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "cookie-parser": "^1.4.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "tsx": "^4.6.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "drizzle-kit": "^0.20.4"
  },
  "keywords": ["whatsapp", "webhook", "ai", "classification", "dashboard"],
  "author": "",
  "license": "ISC"
}